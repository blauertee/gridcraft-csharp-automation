<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Gridcraft.Automation/Gridcraft.Automation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NativeOutputDir)gridcraft_ffi.dll" Condition="Exists('$(NativeOutputDir)gridcraft_ffi.dll')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NativeOutputDir)libgridcraft_ffi.so" Condition="Exists('$(NativeOutputDir)libgridcraft_ffi.so')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
